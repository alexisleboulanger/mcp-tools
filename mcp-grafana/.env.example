# Grafana connection for pre1 Vienna Yorizon environment
GRAFANA_URL=https://grafana.ops-services.at-pre1.yrzn.cloud

# Auth option 1: API key or service-account token
# GRAFANA_API_KEY=glsa_xxxxxxxxxxxxxxxxxxxx

# Auth option 2: Basic auth (admin username/password)
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-admin-password

# Optional: default Prometheus datasource UID (auto-detected if omitted)
# GRAFANA_DATASOURCE_UID=prometheus
# Optional: default namespace filter
# GRAFANA_DEFAULT_NAMESPACE=
