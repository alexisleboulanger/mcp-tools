{
   "inputs": [
      {
         "id": "ado_org",
         "type": "promptString",
         "description": "Azure DevOps organization name (e.g. 'yorizon')",
         "default": "yorizon"
      }
   ],
   "servers": {
      "chat-backup": {
         "type": "stdio",
         "command": "node",
         "args": ["C:\\dev\\mcp\\mcp-chat-backup\\server.js"],
         "env": {
            "CHAT_BACKUP_PATH": "C:\\dev\\mcp\\.knowledge\\solution\\services\\chat-backups"
         }
      },
      "m365": {
         "type": "stdio",
         "command": "node",
         "args": ["C:\\dev\\mcp\\mcp-365\\src\\index.js"]
      },
      "ado-wrapped": {
         "type": "stdio",
         "command": "node",
         "args": ["C:\\dev\\mcp\\mcp-ado-wrapper\\wrapper.js"]
      },
      "miro": {
         "type": "sse",
         "url": "http://localhost:8899/sse"
      },
      "memory": {
         "command": "npx",
         "args": [
         "-y",
         "@modelcontextprotocol/server-memory"],
         "env": {
            "MEMORY_STORAGE_PATH": "C:\\dev\\mcp\\.knowledge\\.memory"
         }
      },
      "sequential-thinking": {
         "command": "npx",
         "args": [
         "-y",
         "@modelcontextprotocol/server-sequential-thinking"]
      },
      "serp": {
         "type": "stdio",
         "command": "node",
         "args": [
            "C:\\dev\\mcp\\mcp-serp-wrapper\\serp-wrapper.js"
         ]
      },
      "knowledge": {
         "type": "stdio",
         "command": "node",
         "args": [
            "C:\\dev\\mcp\\mcp-knowledge\\server.js"
         ],
         "env": {
            "KNOWLEDGE_PATH": "C:\\dev\\mcp\\.knowledge"
         }
      }
      ,"git": {
      "type": "stdio",
      "command": "C:\\dev\\mcp\\mcp-server-git\\.venv\\Scripts\\python.exe",
      "args": ["-m", "mcp_server_git", "--repository", "C:\\dev\\yorizon"]  
      }
      ,"agent-runtime": {
         "type": "stdio",
         "command": "node",
         "args": ["C:\\dev\\mcp\\mcp-agent-runtime-bridge\\server.js"],
         "env": {
            "AGENT_RUNTIME_URL": "http://localhost:8000",
            "AGENT_RUNTIME_WORKDIR": "C:\\dev\\yorizon\\yorizon-agent-runtime",
            "AGENT_RUNTIME_PYTHON": "C:\\dev\\yorizon\\yorizon-agent-runtime\\.venv\\Scripts\\python.exe"
         }
      }
   }
}