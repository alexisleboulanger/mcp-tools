# Microsoft Entra ID (Azure AD) Application Registration
# Create an app registration at https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps

# Application (client) ID from app registration
MICROSOFT_CLIENT_ID=your-client-id-here

# Client secret (for confidential client flow)
# For user delegation, leave empty and use interactive login
MICROSOFT_CLIENT_SECRET=

# Directory (tenant) ID - use 'common' for multi-tenant
MICROSOFT_TENANT_ID=your-tenant-id-or-common

# Redirect URI for interactive auth (must match app registration)
# Default: http://localhost:3847/auth/callback
MICROSOFT_REDIRECT_URI=http://localhost:3847/auth/callback

# ========================================================================
# AUTHENTICATION OPTIONS (Choose one):
# ========================================================================

# OPTION 1: Tenant-approved delegated application (RECOMMENDED)
# -----------------------------------------------------------------
# Best option - opens browser for secure login and maintains an MSAL token cache.
# Tokens are cached and auto-refreshed.
#
# Setup:
# 1. Register an app at Azure Portal → App Registrations
# 2. Add redirect URI: http://localhost:3847/auth/callback
# 3. Enable "Allow public client flows" under Authentication
# 4. Set MICROSOFT_CLIENT_ID above
# 5. Run: npm run token:login
#
# Required App Registration settings:
# - Redirect URI: http://localhost:3847/auth/callback (Mobile/Desktop)
# - Allow public client flows: Yes
# - Supported account types: Accounts in this org directory only
#
# Tenant policy decides whether delegated scopes require administrator consent.
# Request only the scopes used by enabled tools. Do not use a Microsoft first-party
# application ID or Graph Explorer redirect URI: redirect URIs are bound to the client app.

# OPTION 2: Pre-acquired token (troubleshooting only)
# -----------------------------------------------------------------
# A Graph Explorer token can prove an endpoint works, but expires quickly and must
# not be used as a deployment authentication mechanism.
#
MICROSOFT_ACCESS_TOKEN=

# OPTION 3: Azure CLI (automatic, but limited scopes)
# -----------------------------------------------------------------
# Leave MICROSOFT_ACCESS_TOKEN empty and no client ID to use Azure CLI.
# Run: az login --tenant YOUR_TENANT_ID
# Works for: /me, /users, /groups, /sites listing
# Does NOT work for: Mail, Calendar, Files content

# OPTION 4: Device Code Flow
# -----------------------------------------------------------------
# For headless environments where browser isn't available.
# Set MICROSOFT_CLIENT_ID and USE_DEVICE_CODE=true
USE_DEVICE_CODE=false

# ========================================================================

# Optional: Refresh token for token renewal
MICROSOFT_REFRESH_TOKEN=

# Scopes requested (space-separated). Submit this scope set for approval and keep it
# limited to enabled tools. Add Teams or recording scopes only when specifically approved.
MICROSOFT_SCOPES=User.Read Files.Read.All Sites.Read.All Mail.Read Calendars.Read offline_access

# Optional: Specific SharePoint site URL to scope searches
# e.g., https://contoso.sharepoint.com/sites/engineering
SHAREPOINT_SITE_URL=

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info
